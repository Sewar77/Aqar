// Aqar — Sprint 1 database proposal
// New database only. Review before applying. Prisma 7 datasource URL lives in prisma7.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PropertyContactRole {
  OWNER
  CO_OWNER
  AUTHORIZED_REPRESENTATIVE
}

enum AreaUnit {
  SQUARE_METER
  DUNUM
  OTHER
}

enum TransactionType {
  SALE
  RENT
}

enum OfferingStatus {
  AVAILABLE
  RESERVED
  UNDER_NEGOTIATION
  SOLD
  RENTED
  WITHDRAWN
}

enum RentalPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  OTHER
}

enum PropertyEventType {
  CREATED
  UPDATED
  PRICE_CHANGED
  STATUS_CHANGED
  CONTACT_CHANGED
  PHOTO_CHANGED
  NOTE_ADDED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String   @map("full_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// Primary browse/filter unit: e.g. المزار الشمالي, دير يوسف, عنبة.
// Admin creates locations. No governorate/city hierarchy in Sprint 1.
model Location {
  id         String   @id @default(uuid()) @db.Uuid
  nameAr     String   @unique @map("name_ar")
  nameEn     String?  @map("name_en")
  notes      String?
  isActive   Boolean  @default(true) @map("is_active")
  properties Property[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("locations")
}

model PropertyType {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  nameAr     String   @map("name_ar")
  nameEn     String?  @map("name_en")
  isActive   Boolean  @default(true) @map("is_active")
  properties Property[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("property_types")
}

model Property {
  id                 String         @id @default(uuid()) @db.Uuid
  propertyCode       String         @unique @map("property_code") // human-friendly, e.g. AQ-00001
  title              String
  description        String?
  internalNotes      String?        @map("internal_notes")
  typeId             String         @map("type_id") @db.Uuid
  type               PropertyType   @relation(fields: [typeId], references: [id], onDelete: Restrict)
  locationId         String         @map("location_id") @db.Uuid
  location           Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  address            String?
  latitude           Decimal?       @db.Decimal(10, 7)
  longitude          Decimal?       @db.Decimal(10, 7)
  areaValue          Decimal?       @map("area_value") @db.Decimal(12, 2)
  areaUnit           AreaUnit?      @map("area_unit")
  areaUnitLabel      String?        @map("area_unit_label")
  areaInSquareMeters Decimal?       @map("area_in_square_meters") @db.Decimal(14, 2)
  status             PropertyStatus @default(DRAFT)
  parentPropertyId   String?        @map("parent_property_id") @db.Uuid
  parentProperty     Property?      @relation("PropertyHierarchy", fields: [parentPropertyId], references: [id], onDelete: SetNull)
  childProperties    Property[]     @relation("PropertyHierarchy")
  contacts           PropertyContact[]
  offerings          PropertyOffering[]
  photos             PropertyPhoto[]
  events             PropertyEvent[]
  createdAt          DateTime       @default(now()) @map("created_at") // registration timestamp
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@index([locationId, status])
  @@index([typeId])
  @@index([parentPropertyId])
  @@index([createdAt])
  @@map("properties")
}

model Contact {
  id               String   @id @default(uuid()) @db.Uuid
  fullName         String   @map("full_name")
  phone            String
  alternativePhone String?  @map("alternative_phone")
  email            String?
  notes            String?
  properties       PropertyContact[]
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([phone])
  @@index([fullName])
  @@map("contacts")
}

model PropertyContact {
  id            String              @id @default(uuid()) @db.Uuid
  propertyId    String              @map("property_id") @db.Uuid
  property      Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contactId     String              @map("contact_id") @db.Uuid
  contact       Contact             @relation(fields: [contactId], references: [id], onDelete: Restrict)
  role          PropertyContactRole
  isPrimary     Boolean             @default(false) @map("is_primary")
  canSharePhone Boolean             @default(false) @map("can_share_phone")
  createdAt     DateTime            @default(now()) @map("created_at")

  @@unique([propertyId, contactId, role])
  @@index([contactId])
  @@map("property_contacts")
}

// One property may have distinct sale and rental offers.
// ownerPrice = initial requested price; advertisedPrice = public asking price;
// finalPrice = actual agreed/closed price, populated when a deal closes.
model PropertyOffering {
  id               String         @id @default(uuid()) @db.Uuid
  propertyId       String         @map("property_id") @db.Uuid
  property         Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  transactionType  TransactionType @map("transaction_type")
  ownerPrice       Decimal        @map("owner_price") @db.Decimal(12, 2)
  advertisedPrice  Decimal        @map("advertised_price") @db.Decimal(12, 2)
  finalPrice       Decimal?       @map("final_price") @db.Decimal(12, 2)
  currency         String         @default("JOD")
  rentalPeriod     RentalPeriod?  @map("rental_period")
  allowNegotiation Boolean        @default(true) @map("allow_negotiation")
  status           OfferingStatus @default(AVAILABLE)
  closedAt         DateTime?      @map("closed_at")
  notes            String?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([propertyId])
  @@index([transactionType, status])
  @@map("property_offerings")
}

model PropertyPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  storageKey String   @map("storage_key")
  fileName   String   @map("file_name")
  mimeType   String?  @map("mime_type")
  sizeBytes  Int?     @map("size_bytes")
  sortOrder  Int      @default(0) @map("sort_order")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([propertyId, sortOrder])
  @@map("property_photos")
}

model PropertyEvent {
  id          String            @id @default(uuid()) @db.Uuid
  propertyId  String            @map("property_id") @db.Uuid
  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  eventType   PropertyEventType @map("event_type")
  title       String
  description String?
  oldPrice    Decimal?          @map("old_price") @db.Decimal(12, 2)
  newPrice    Decimal?          @map("new_price") @db.Decimal(12, 2)
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([propertyId, createdAt])
  @@map("property_events")
}
